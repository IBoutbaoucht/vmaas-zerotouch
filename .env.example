# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#   $EDITOR .env
#
# `.env` is gitignored. Both compose services source it via env_file.

# ESXi root password for the host configured in backend/configs/vmaas.yaml.
# This is the same password you use for `govc` / `ssh root@<esxi-host>`.
ESXI_PASSWORD=changeme

# Shared secret sent by the UI as `Authorization: Bearer <token>`.
# Pick something long and random. Anyone with this token can create or
# destroy VMs on your hypervisor.
VMAAS_TOKEN=changeme-pick-a-long-random-string
